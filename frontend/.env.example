# Leave this unset for local development — Vite's dev server proxies
# /api and /uploads requests to http://localhost:5000 automatically (see vite.config.js).
#
# For production (after deploying the backend), set this to your deployed
# backend's URL, including /api at the end. Example:
# VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=
