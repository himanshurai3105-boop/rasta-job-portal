PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/job_portal
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Optional — email alerts are skipped gracefully if these aren't set.
# For Gmail: enable 2FA on the account, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use that as EMAIL_PASS.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="rasta <your-email@gmail.com>"

# Required for AI resume screening + AI interview features.
# Get one at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
